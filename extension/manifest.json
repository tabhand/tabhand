{
  "manifest_version": 3,
  "name": "Tabhand",
  "version": "0.11.0",
  "description": "Lets AI agents work in background tabs of your Chrome without stealing focus.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "minimum_chrome_version": "125",
  "permissions": [
    "debugger",
    "nativeMessaging",
    "tabGroups",
    "storage",
    "alarms",
    "scripting"
  ],
  "optional_permissions": [
    "identity",
    "identity.email"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Tabhand",
    "default_popup": "panel.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "key": ""
}
